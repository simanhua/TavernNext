{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["事件", "世界", "任务列表", "主角", "命运点数", "关系列表", "地图"],
  "properties": {
    "事件": {
      "type": "object",
      "additionalProperties": false,
      "required": ["开启", "结束", "标题", "阶段", "已完成事件"],
      "properties": {
        "开启": { "type": "boolean" },
        "结束": { "type": "boolean" },
        "标题": { "type": "string" },
        "阶段": { "type": "string" },
        "已完成事件": { "type": "array", "items": { "type": "string" } }
      }
    },
    "世界": {
      "type": "object",
      "additionalProperties": false,
      "required": ["时间", "地点"],
      "properties": { "时间": { "type": "string" }, "地点": { "type": "string" } }
    },
    "任务列表": { "type": "object", "additionalProperties": true },
    "主角": {
      "type": "object",
      "additionalProperties": false,
      "required": ["姓名", "描述", "种族", "身份", "职业", "生命层级", "等级", "累计经验值", "升级所需经验", "冒险者等级", "属性点", "属性", "生命值上限", "生命值", "法力值上限", "法力值", "体力值上限", "体力值", "状态效果", "金钱", "装备", "背包", "技能"],
      "properties": {
        "姓名": { "type": "string" },
        "描述": { "type": "string" },
        "种族": { "type": "string" },
        "身份": { "type": "array", "items": { "type": "string" } },
        "职业": { "type": "array", "items": { "type": "string" } },
        "生命层级": { "type": "string" },
        "等级": { "type": "integer", "minimum": 1 },
        "累计经验值": { "type": "number", "minimum": 0 },
        "升级所需经验": { "type": "number", "minimum": 0 },
        "冒险者等级": { "type": "string" },
        "属性点": { "type": "integer", "minimum": 0 },
        "属性": {
          "type": "object",
          "additionalProperties": false,
          "required": ["力量", "敏捷", "体质", "智力", "精神"],
          "properties": {
            "力量": { "type": "number", "minimum": 0 },
            "敏捷": { "type": "number", "minimum": 0 },
            "体质": { "type": "number", "minimum": 0 },
            "智力": { "type": "number", "minimum": 0 },
            "精神": { "type": "number", "minimum": 0 }
          }
        },
        "生命值上限": { "type": "number", "minimum": 0 },
        "生命值": { "type": "number", "minimum": 0 },
        "法力值上限": { "type": "number", "minimum": 0 },
        "法力值": { "type": "number", "minimum": 0 },
        "体力值上限": { "type": "number", "minimum": 0 },
        "体力值": { "type": "number", "minimum": 0 },
        "状态效果": { "type": "object", "additionalProperties": true },
        "金钱": { "type": "number", "minimum": 0 },
        "装备": { "type": "object", "additionalProperties": true },
        "背包": { "type": "object", "additionalProperties": true },
        "技能": { "type": "object", "additionalProperties": true }
      }
    },
    "命运点数": { "type": "number", "minimum": 0 },
    "关系列表": { "type": "object", "additionalProperties": true },
    "地图": {
      "type": "object",
      "additionalProperties": false,
      "required": ["标记"],
      "properties": {
        "标记": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "name", "group", "description", "position"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "group": { "type": "string" },
              "description": { "type": "string" },
              "position": {
                "type": "object",
                "required": ["nx", "ny"],
                "properties": { "nx": { "type": "number" }, "ny": { "type": "number" } }
              },
              "imageUrls": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
